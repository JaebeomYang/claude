# Toss Invest Open API credentials (never commit real values)
TOSS_API_BASE_URL=https://api.tossinvest.com
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# Optional: set if the account access token is issued out-of-band instead of
# via a client-credentials flow (depends on the actual Toss Open API auth spec,
# which still needs to be confirmed against developers.tossinvest.com).
TOSS_ACCESS_TOKEN=

# Alert thresholds
ALERT_PRICE_CHANGE_PCT=3.0
ALERT_VOLUME_MULTIPLE=2.0

# Notification (email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
