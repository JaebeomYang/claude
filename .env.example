# Toss Invest Open API credentials (never commit real values)
TOSS_API_BASE_URL=https://openapi.tossinvest.com
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# Optional: skip the client_credentials token request and use a pre-issued
# access token instead.
TOSS_ACCESS_TOKEN=

# Alert thresholds
ALERT_PRICE_CHANGE_PCT=3.0
ALERT_VOLUME_MULTIPLE=2.0

# Notification channels — configure at least one. All configured channels
# receive every digest/alert; if one fails the others still get sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
