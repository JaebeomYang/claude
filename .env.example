# 토스증권 Open API 인증 정보 (실제 값은 절대 커밋하지 않는다)
TOSS_API_BASE_URL=https://openapi.tossinvest.com
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# 선택사항: client_credentials 토큰 발급 요청 없이, 미리 발급받은
# 액세스 토큰을 바로 사용하고 싶을 때 설정.
TOSS_ACCESS_TOKEN=

# 알림 임계값
ALERT_PRICE_CHANGE_PCT=3.0
ALERT_VOLUME_MULTIPLE=2.0

# 알림 채널 — 최소 하나는 설정해야 한다. 설정된 채널 전체로 매 다이제스트/
# 알림이 발송되며, 한 채널이 실패해도 나머지는 정상적으로 발송된다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# 텔레그램: @BotFather로 봇을 만들어 토큰을 발급받고, 봇과 대화를 시작한 뒤
# https://api.telegram.org/bot<TOKEN>/getUpdates 로 chat_id를 확인한다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
